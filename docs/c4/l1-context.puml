@startuml AulaViva_C4_L1

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title AulaViva - C4 Nivel 1 - Diagrama de Contexto


Person(estudiante, "Estudiante", "Consulta contenidos, utiliza Tutor IA y revisa evaluaciones")

Person(docente, "Docente", "Gestiona cursos, crea evaluaciones y revisa resultados")

Person(apoderado, "Apoderado", "Consulta rendimiento académico")

Person(coordinador, "Coordinador académico", "Administra cursos, usuarios y configuración")

Person(sostenedor, "Sostenedor", "Gestiona establecimientos y acceso multi-tenant")


System(aulaviva, "AulaViva", "Plataforma educativa SaaS con inteligencia artificial")


System_Ext(mineduc, "MINEDUC", "Estándares educativos y referencias curriculares")

System_Ext(email, "Servicio Email", "Envío de correos y alertas")


Rel(estudiante, aulaviva, "Utiliza")

Rel(docente, aulaviva, "Administra contenido")

Rel(apoderado, aulaviva, "Consulta información")

Rel(coordinador, aulaviva, "Configura plataforma")

Rel(sostenedor, aulaviva, "Administra colegios")

Rel(aulaviva, mineduc, "Consulta referencias")

Rel(aulaviva, email, "Envía notificaciones")


@enduml
